MYSQL_URL=jdbc:mysql://localhost:<port>/<database-name>
MYSQL_USERNAME=username-example
MYSQL_PASSWORD=password-example
DDL_AUTO=create
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE_NAME=courseitda
KAKAO_API_KEY=your_kakao_api_key
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# 모니터링 설정 (docker-compose.monitoring.yml에서 사용)
SPRING_SERVER_IP=your_spring_server_ip
SPRING_SERVER_PORT=your_spring_server_port

# Grafana 관리자 계정 (로컬 환경용)
# ⚠️ 여기를 수정하세요! - Grafana 로그인 시 사용할 아이디/비밀번호
GRAFANA_ADMIN_USER=your_grafana_username
GRAFANA_ADMIN_PASSWORD=your_grafana_password
